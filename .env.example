# Configurações do Ambiente
# Valores possíveis: development, test, production
NODE_ENV=development

# Configurações do Banco de Dados
# URL de conexão com o PostgreSQL
DATABASE_URL=

# Configurações de Segurança
JWT_SECRET=

# Configurações do Servidor
PORT=

# Firebase Admin — push notifications (opcional).
# Console do Firebase → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada. Os três valores saem do JSON baixado.
# A private key vai entre aspas, com as quebras de linha escapadas como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY= 

# Vercel Cron — segredo do GET /internal/cron/daily (gerar com: openssl rand -hex 32).
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" quando a variável existe no projeto.
CRON_SECRET=
