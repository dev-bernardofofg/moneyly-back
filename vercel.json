{
  "version": 2,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/internal/cron/daily", "schedule": "0 9 * * *" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/.pnpm/@napi-rs+canvas*/**,node_modules/.pnpm/pdf-parse@*/node_modules/@napi-rs/**}"
    }
  }
}
